---
const navLinks = [
  { href: '/', label: '首页' },
  { href: '/resume', label: '个人履历' },
  { href: '/portfolio', label: '作品集' },
];

const moreLinks = [
  { href: '/skills-explorer', label: 'AI 探索' },
  { href: '/blog', label: '博客' },
  { href: '/murmurs', label: '碎碎念' },
];

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/';
const isPortfolioDetail = currentPath.startsWith('/portfolio/') && currentPath !== '/portfolio';
const isImmersivePage = isHomePage || isPortfolioDetail || currentPath.startsWith('/tarot');

const isMoreActive = moreLinks.some(({ href }) => currentPath.startsWith(href));
---

<header
  class:list={[
    'site-header top-0 z-50',
    isImmersivePage
      ? 'site-header--immersive absolute inset-x-0 border-b-0 bg-transparent'
      : 'site-header--default sticky border-b border-slate-800/60 bg-slate-950/80 backdrop-blur-md',
  ]}
>
  <div
    class:list={[
      'site-header__inner mx-auto flex items-center justify-between px-6 py-4',
      isImmersivePage ? 'max-w-7xl' : 'site-header__inner--standard max-w-5xl',
    ]}
  >
    <!-- Logo / Site Name -->
    <a
      href="/"
      class="site-logo text-lg font-bold tracking-tight text-slate-100 transition-opacity hover:opacity-80"
    >
      <span class="text-violet-400">&lt;</span>cy<span class="text-violet-400">/&gt;</span>
    </a>

    <!-- Navigation Links -->
    <nav class="site-nav" aria-label="主导航">
      <ul class="site-nav__list flex items-center gap-1">
        {
          navLinks.map(({ href, label }) => {
            const isActive =
              href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(href);
            return (
              <li class="site-nav__item">
                <a
                  href={href}
                  class:list={[
                    'site-nav__link rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
                    isActive
                      ? 'site-nav__link--active bg-violet-500/15 text-violet-300'
                      : 'text-slate-400 hover:bg-slate-800 hover:text-slate-100',
                  ]}
                >
                  {label}
                </a>
              </li>
            );
          })
        }

        <!-- 更多 dropdown -->
        <li class="site-nav__item site-nav__more">
          <button
            type="button"
            class:list={[
              'site-nav__link site-nav__more-trigger rounded-md px-3 py-1.5 text-sm font-medium transition-colors flex items-center gap-1',
              isMoreActive
                ? 'site-nav__link--active bg-violet-500/15 text-violet-300'
                : 'text-slate-400 hover:bg-slate-800 hover:text-slate-100',
            ]}
            aria-haspopup="true"
            aria-expanded="false"
            id="more-menu-trigger"
          >
            更多
            <svg class="site-nav__chevron w-3 h-3 transition-transform duration-200" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 4l4 4 4-4"/>
            </svg>
          </button>
          <ul
            class="site-nav__dropdown"
            role="menu"
            aria-labelledby="more-menu-trigger"
          >
            {moreLinks.map(({ href, label }) => {
              const isActive = currentPath.startsWith(href) || (href === '/skills-explorer' && currentPath.startsWith('/tarot'));
              return (
                <li role="none">
                  <a
                    href={href}
                    role="menuitem"
                    class:list={[
                      'site-nav__dropdown-item',
                      isActive && 'site-nav__dropdown-item--active',
                    ]}
                  >
                    {label}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style is:inline>
  .site-header {
    width: 100%;
  }

  .site-header--default {
    position: sticky;
    top: 0;
    border-bottom: 1px solid rgba(30, 41, 59, 0.6);
    background: rgba(2, 6, 23, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-header--immersive {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__inner--standard {
    max-width: 64rem;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    color: #f8fafc !important;
    text-decoration: none !important;
    white-space: nowrap;
  }

  .site-nav {
    min-width: 0;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__item {
    list-style: none;
  }

  /* iOS 14.2 Safari 兼容性 CSS */
  .site-header a {
    color: #94a3b8 !important;
    text-decoration: none !important;
  }

  .site-logo {
    color: #f8fafc !important;
  }

  .site-nav__link {
    display: block;
    border-radius: 8px;
    color: #94a3b8 !important;
    text-decoration: none !important;
    white-space: nowrap;
    padding: 6px 12px;
    background: transparent;
    -webkit-appearance: none;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
    border: none;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: inherit;
  }

  .site-nav__link:link,
  .site-nav__link:visited,
  .site-nav__link:active {
    color: #94a3b8 !important;
    text-decoration: none !important;
  }

  .site-nav__link:hover,
  .site-nav__link:focus {
    color: #f8fafc !important;
    background: #1e293b;
    text-decoration: none !important;
  }

  .site-nav__link--active,
  .site-nav__link--active:link,
  .site-nav__link--active:visited {
    background: rgba(139, 92, 246, 0.15);
    color: #c4b5fd !important;
    text-decoration: none !important;
  }

  /* Dropdown */
  .site-nav__more {
    position: relative;
  }

  .site-nav__more-trigger {
    display: inline-flex;
    align-items: center;
  }

  .site-nav__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 120px;
    background: rgba(2, 6, 23, 0.96);
    border: 1px solid rgba(30, 41, 59, 0.8);
    border-radius: 10px;
    padding: 4px;
    margin: 0;
    list-style: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    z-index: 100;
  }

  .site-nav__more.is-open .site-nav__dropdown {
    display: block;
  }

  .site-nav__more.is-open .site-nav__chevron {
    transform: rotate(180deg);
  }

  .site-nav__dropdown-item {
    display: block;
    padding: 7px 12px;
    border-radius: 7px;
    font-size: 0.875rem;
    color: #94a3b8 !important;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }

  .site-nav__dropdown-item:hover {
    background: #1e293b;
    color: #f8fafc !important;
  }

  .site-nav__dropdown-item--active {
    background: rgba(139, 92, 246, 0.15);
    color: #c4b5fd !important;
  }

  @media (max-width: 960px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .site-nav {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .site-nav__list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      min-width: max-content;
      padding-bottom: 0.2rem;
    }

    .site-nav__dropdown {
      right: auto;
      left: 0;
    }
  }

  @media (max-width: 480px) {
    .site-header__inner {
      gap: 1rem;
      padding: 1rem 1.5rem;
    }

    .site-nav__list {
      gap: 0.5rem;
    }

    .site-nav__link {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  const moreItem = document.querySelector('.site-nav__more');
  const trigger = document.getElementById('more-menu-trigger');

  if (moreItem && trigger) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = moreItem.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', () => {
      moreItem.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        moreItem.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      }
    });
  }
</script>
